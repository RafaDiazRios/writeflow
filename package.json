{
  "name": "writeflow",
  "private": true,
  "version": "0.4.3",
  "type": "module",
  "description": "WriteFlow — diario calendarizado, novela, ensayos y terapia narrativa. Offline-first para Windows.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "mirar": "npm run build && node scripts/mirar.mjs",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "test": "npm run test:db && npm run test:export && npm run test:i18n",
    "test:db": "esbuild scripts/test-repo.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/test-repo.mjs --loader:.json=json --alias:@tauri-apps/plugin-sql=./scripts/stub-sql.mjs --alias:@=./src --external:node:sqlite && node node_modules/.tmp/test-repo.mjs",
    "test:export": "esbuild scripts/test-export.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/test-export.mjs --alias:@=./src --external:node:fs && node node_modules/.tmp/test-export.mjs",
    "test:ui": "npm run build && node scripts/preview-escritorio.mjs",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --apk --target aarch64",
    "test:i18n": "esbuild scripts/test-i18n.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/test-i18n.mjs --alias:@=./src && node node_modules/.tmp/test-i18n.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.0.1",
    "@tauri-apps/plugin-fs": "^2.0.3",
    "@tauri-apps/plugin-opener": "^2.2.5",
    "@tauri-apps/plugin-os": "^2.0.1",
    "@tauri-apps/plugin-sql": "^2.0.2",
    "@tiptap/extension-character-count": "^2.10.3",
    "@tiptap/extension-color": "^2.27.2",
    "@tiptap/extension-focus": "^2.27.2",
    "@tiptap/extension-font-family": "^2.27.2",
    "@tiptap/extension-highlight": "^2.10.3",
    "@tiptap/extension-image": "^2.10.3",
    "@tiptap/extension-link": "^2.10.3",
    "@tiptap/extension-placeholder": "^2.10.3",
    "@tiptap/extension-subscript": "^2.10.3",
    "@tiptap/extension-superscript": "^2.10.3",
    "@tiptap/extension-table": "^2.10.3",
    "@tiptap/extension-table-cell": "^2.10.3",
    "@tiptap/extension-table-header": "^2.10.3",
    "@tiptap/extension-table-row": "^2.10.3",
    "@tiptap/extension-task-item": "^2.10.3",
    "@tiptap/extension-task-list": "^2.10.3",
    "@tiptap/extension-text-align": "^2.10.3",
    "@tiptap/extension-text-style": "^2.27.2",
    "@tiptap/extension-typography": "^2.10.3",
    "@tiptap/extension-underline": "^2.10.3",
    "@tiptap/pm": "^2.10.3",
    "@tiptap/react": "^2.10.3",
    "@tiptap/starter-kit": "^2.10.3",
    "date-fns": "^4.1.0",
    "docx": "^9.7.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "uuid": "^11.0.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.2",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
