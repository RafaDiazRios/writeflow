# Copia este archivo como `.env` si prefieres incrustar las credenciales en el
# binario. También puedes dejarlo vacío y escribirlas desde Ajustes dentro de la
# aplicación: se guardan solo en tu base de datos local.
#
# La clave "anon"/"publishable" es pública por diseño: la seguridad real la dan
# las políticas RLS de `supabase/migrations/0001_init.sql`.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
